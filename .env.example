# Postgres. Local dev: `npm run db` starts an embedded Postgres (PGlite) on port 5433;
# pgbouncer=true is needed because PGlite shares one session across connections.
# Production (Neon): pooled ("-pooler") URL here, direct URL in DIRECT_URL.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable&connection_limit=1&pgbouncer=true"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable&connection_limit=1&pgbouncer=true"

AUTH_SECRET="replace-with-output-of-openssl-rand-base64-32"
APP_URL="http://localhost:3000"

# Local dev: `npm run mail` catches mail on 127.0.0.1:1025.
# Production (Brevo): SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587, SMTP_USER=<Brevo login>, SMTP_PASS=<SMTP key>
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
# Must be a sender address verified in Brevo when sending for real.
MAIL_FROM="Card Offers Tracker <offers@localhost>"

# Comma-separated emails that become admins on registration.
# When empty, the first account on a fresh database becomes admin (local dev only).
ADMIN_EMAILS=""
# When set, registration requires this code. Leave empty for open registration.
INVITE_CODE=""

# When both are set, the admin "Scrape now" button starts the GitHub Actions workflow
# instead of scraping inside the web server (required on Vercel).
GITHUB_REPO=""            # e.g. your-name/cards-offers-tracker
GITHUB_DISPATCH_TOKEN=""  # fine-grained PAT for that repo with Actions: read & write
